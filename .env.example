# Port the Express server listens on
PORT=3000

# ---- Telegram Bot API ----
# See README.md "Telegram Setup" section for full step-by-step instructions.

# The token BotFather gives you when you create your bot
TELEGRAM_BOT_TOKEN=

# The chat ID that should receive booking alerts (your personal chat with
# the bot, or a group's chat ID if you add the bot to a group)
TELEGRAM_CHAT_ID=

# ---- CORS (only needed if the frontend is hosted separately, e.g. GitHub Pages) ----
# Set this to your GitHub Pages URL once you have it, e.g.:
# ALLOWED_ORIGIN=https://yourusername.github.io
# Leave unset (or *) to allow any origin, which is fine for testing.
ALLOWED_ORIGIN=*
